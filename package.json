{
  "name": "tabitha-workspaces",
  "version": "1.10.0",
  "private": true,
  "description": "A private, local-first workspace and tab collection manager for Chromium and Firefox.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "prepare": "node scripts/generate-icons.mjs && wxt prepare",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:firefox": "web-ext lint --source-dir .output/firefox-mv3",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "npm run build:chromium && npm run build:firefox",
    "build:chromium": "wxt build -b chrome --mv3",
    "build:firefox": "wxt build -b firefox --mv3",
    "check:build": "node scripts/validate-build.mjs",
    "zip": "npm run zip:chromium && npm run zip:firefox",
    "zip:chromium": "wxt zip -b chrome --mv3",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run check:build && npm run lint:firefox && npm run zip"
  },
  "dependencies": {
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "sharp": "0.35.3",
    "typescript": "7.0.2",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11",
    "web-ext": "10.6.0",
    "wxt": "0.21.4"
  },
  "engines": {
    "node": ">=20.19"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "esbuild": "0.28.1",
    "fast-uri": "3.1.5",
    "shell-quote": "1.10.0",
    "tmp": "0.2.7",
    "undici": "7.29.0",
    "uuid": "11.1.1"
  }
}
